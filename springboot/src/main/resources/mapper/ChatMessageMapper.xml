<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.dao.ChatMessageDao">

    <select id="findBySearch" resultType="com.example.entity.ChatMessage">
        select `chat_message`.* from `chat_message`
        where 1 = 1
    </select>

    <select id="findByRoomId" resultType="com.example.entity.ChatMessage">
        SELECT * FROM chat_message
        WHERE room_id = #{roomId}
        ORDER BY time DESC
        LIMIT #{page}, #{size}
    </select>

</mapper>